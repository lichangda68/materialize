# DeepSeek API 配置
# 使用方法：复制本文件为 .env，填入真实密钥后启动（.env 已被 .gitignore 忽略，不会提交）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容端点与模型（默认 DeepSeek，可换成任意 OpenAI 兼容服务）
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# 可选：请求超时（毫秒）与监听端口
TIMEOUT_MS=60000
PORT=3001

# 可选：监听地址（默认 127.0.0.1 仅本机；如需局域网访问可设为 0.0.0.0）
HOST=127.0.0.1
